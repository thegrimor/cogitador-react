generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  characters     Character[]
  sequitoEntries SequitoEntry[]
  proyectos      Proyecto[]
  notas          Nota[]
  resetTokens    PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Datos de ficha de personaje. `data` guarda el árbol completo (atributos,
// heridas, xp, etc.) tal como lo modela el frontend en fichaTypes.ts;
// se mantiene como JSON porque ese modelo todavía está en evolución.
model Character {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("characters")
}

// Entrada de séquito (acólito/aliado). Módulo `sequito` aún es un stub en el
// frontend, así que `data` queda libre hasta que se defina el modelo real.
model SequitoEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sequito_entries")
}

// Proyecto de campaña. Módulo `proyectos` aún es un stub en el frontend,
// mismo criterio que SequitoEntry.
model Proyecto {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("proyectos")
}

// Notas temáticas (módulo `notas`). `data` guarda el NotasState completo
// (notes: Note[], con characterId? apuntando a un Character — sin FK real
// porque characterId vive dentro del JSON, no como columna).
model Nota {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notas")
}
