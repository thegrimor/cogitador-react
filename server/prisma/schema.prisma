generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MASTER
  USER
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  characters          Character[]
  sequitoEntries      SequitoEntry[]
  proyectos           Proyecto[]
  resetTokens         PasswordResetToken[]
  campaignsMastered   Campaign[]       @relation("CampaignsMastered")
  campaignMemberships CampaignMember[]

  @@map("users")
}

// Partida de rol: un master (dueño, controla la info) y N jugadores
// (members) cuyos datos de Ficha/Séquito/Proyectos se comparten en modo
// solo lectura dentro de la partida. La info del propio master nunca se
// expone — no es un CampaignMember de su propia partida.
model Campaign {
  id        String           @id @default(uuid())
  name      String
  masterId  String
  master    User             @relation("CampaignsMastered", fields: [masterId], references: [id], onDelete: Cascade)
  members   CampaignMember[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([masterId])
  @@map("campaigns")
}

// Tabla puente jugador↔partida. Un jugador puede pertenecer a varias
// partidas (relación muchos-a-muchos).
model CampaignMember {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_members")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Datos de ficha de personaje. `data` guarda el árbol completo (atributos,
// heridas, xp, etc.) tal como lo modela el frontend en fichaTypes.ts;
// se mantiene como JSON porque ese modelo todavía está en evolución.
model Character {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("characters")
}

// Entrada de séquito (acólito/aliado). Módulo `sequito` aún es un stub en el
// frontend, así que `data` queda libre hasta que se defina el modelo real.
model SequitoEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sequito_entries")
}

// Proyecto de campaña. Módulo `proyectos` aún es un stub en el frontend,
// mismo criterio que SequitoEntry.
model Proyecto {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("proyectos")
}
